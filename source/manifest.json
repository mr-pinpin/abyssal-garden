      "geometry": "legacy"
    }
  ],
  "assets": {
    "pinpin": {
      "url": "assets/pinpin/pinpin.glb",
      "scale": 1
    },
    "beaver": {
      "url": "assets/pinpin/beaver.glb",
      "scale": 1
    },
    "timber-tractor": {
      "url": "assets/pinpin/timber-tractor.glb",
      "scale": 1
    },
    "footbridge": {
      "url": "assets/pinpin/footbridge.glb",
      "scale": 1
    },
    "windfallen-tree": {
      "url": "assets/pinpin/windfallen-tree.glb",
      "scale": 1
    },
    "materials": {
      "layers": [
        "assets/materials/grass.webp",
        "assets/materials/path.webp",
        "assets/materials/mud.webp",
        "assets/materials/rock.webp",
        "assets/materials/bark.webp",
        "assets/materials/moss.webp"
      ],
      "provenance": "assets/materials/provenance.json"
    },
    "ground-types": {
      "format": "generated-class-grid-v3",
      "url": "assets/atlas-studies/runtime-v3.json"
    }
  },
  "template": "core/forest-template.html",
  "geometry_rule": "Miguel 19 Nov 17:4x: no hardcoded geometry except story props. Each plugin declares geometry: story-prop (authored models: tractor, characters, home, bridge), texture (everything it builds comes from generated textures listed in its inputs, each a manifest asset with provenance), effect (no scene geometry), or legacy (hand-made, being migrated). tests/no-hand-geometry.test.mjs fails the build if legacy grows or an enabled plugin is undeclared."
}
