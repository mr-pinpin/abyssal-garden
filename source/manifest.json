{
  "comment": "Default forest showcase. Enable/disable each plugin independently. Original underwater preset is retained in manifest.underwater.json.",
  "core": [
    "math",
    "forest-shaders"
  ],
  "main": "forest-main",
  "plugins": [
    {
      "name": "gltf-loader",
      "phase": "pre",
      "geometry": "story-prop"
    },
    {
      "name": "fluke",
      "phase": "pre",
