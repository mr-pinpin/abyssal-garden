      "geometry": "legacy"
    },
    {
      "name": "ship",
      "phase": "pre",
      "enabled": false,
      "geometry": "legacy"
    },
    {
      "name": "manta",
      "phase": "pre",
      "enabled": false,
      "geometry": "legacy"
    },
    {
      "name": "fish",
      "phase": "pre",
      "enabled": false,
      "geometry": "legacy"
    },
    {
      "name": "audio",
      "phase": "post",
      "enabled": false,
      "geometry": "effect"
    },
    {
      "name": "dev-tools",
      "phase": "post",
      "dev": true,
      "enabled": false,
      "geometry": "effect"
    },
    {
      "name": "pinpin-home",
      "phase": "pre",
      "enabled": true,
      "geometry": "legacy"
    },
    {
      "name": "elder-sanctuary",
      "phase": "pre",
      "enabled": true,
      "geometry": "legacy"
    },
    {
      "name": "timber-clearing",
      "phase": "pre",
      "enabled": true,
